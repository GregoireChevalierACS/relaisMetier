{
  "name": "relaismetier",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . --max-warnings=0",
    "lint:architecture": "depcruise packages apps --config .dependency-cruiser.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter \"./packages/**\" --filter \"./apps/**\" --parallel typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "pnpm --filter @relaismetier/domain test:mutation",
    "build": "pnpm --filter \"./packages/**\" --filter \"./apps/**\" build",
    "commits:check": "node scripts/verifier-commits.mjs",
    "n8n:exporter": "node scripts/n8n-exporter.mjs",
    "n8n:importer": "node scripts/n8n-importer.mjs",
    "generer:jeu": "pnpm --filter @relaismetier/jeu-synthetique generer",
    "jeu:charger": "pnpm --filter @relaismetier/jeu-synthetique charger",
    "env:creer": "node scripts/creer-env.mjs",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
