# Modèle de configuration. `pnpm env:creer` copie ce fichier dans .env (jamais versionné) et
# donne un secret aléatoire à chaque variable laissée vide.
#
# Les valeurs restent vides ici, plutôt qu'un texte d'exemple : un détecteur de secrets
# (GitGuardian) prendrait « MOT_DE_PASSE=exemple » pour un vrai mot de passe.

# Superutilisateur PostgreSQL : sert seulement à créer les deux bases au premier démarrage.
POSTGRES_PASSWORD=

# Une base et un rôle par usage : n8n ne voit pas les données du service, et inversement.
N8N_DB_PASSWORD=
SERVICE_DB_PASSWORD=

# Chiffre les identifiants enregistrés dans n8n. À sauvegarder : sans elle, ils sont perdus.
N8N_ENCRYPTION_KEY=

# Secret partagé entre n8n et le service (en-tête x-secret-partage). Au moins 32 caractères,
# lettres, chiffres, - et _ seulement.
SECRET_PARTAGE=

# Mot de passe IMAP de chaque boîte décrite dans config/boites.json (BOITE_<ID>_MOT_DE_PASSE).
# Avec GreenMail, sans authentification, n'importe quelle valeur convient. Chez un hébergeur, un
# mot de passe d'application, propre à cet usage.
BOITE_DEVIS_MOT_DE_PASSE=
BOITE_ACCUEIL_MOT_DE_PASSE=
BOITE_COMMANDES_MOT_DE_PASSE=
